<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".fragments.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Sección Médica -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración Médica"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estos valores son necesarios para calcular tu bolo."
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ratio HC (U/ración)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etFactorHC"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 1.5"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space android:layout_width="match_parent" android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensibilidad (mg/dl por U)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etSensibilidad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 50"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space android:layout_width="match_parent" android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Objetivo de glucosa (mg/dl)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etObjetivo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 100"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space android:layout_width="match_parent" android:layout_height="32dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="32dp"/>

        <!-- Sección LibreLinkUp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuenta LibreLinkUp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Introduce las credenciales de tu cuenta LibreLinkUp para ver tu glucosa en tiempo real."
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email de LibreLinkUp"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etLibreEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="usuario@ejemplo.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp" />

        <Space android:layout_width="match_parent" android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña de LibreLinkUp"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etLibrePassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp" />

        <Space android:layout_width="match_parent" android:layout_height="32dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#6200EE"
            android:text="Guardar Configuración"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>