<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".SettingsFragment">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración Médica"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estos valores son necesarios para calcular tu bolo."
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ratio HC (U/ración)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etFactorHC"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 1.5"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensibilidad (mg/dl por U)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etSensibilidad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 50"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Objetivo de glucosa (mg/dl)"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etObjetivo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Ej: 100"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#6200EE"
            android:text="Guardar Configuración"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>