<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/color_primary_light"
    app:strokeColor="@color/color_primary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_md">

        <TextView
            android:id="@+id/tvPerfilActivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="10sp"
            android:textColor="@color/color_primary"
            android:layout_marginEnd="@dimen/space_sm"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPerfilRango"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 - 14:00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary" />

            <TextView
                android:id="@+id/tvPerfilDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ratio: 1.2 U/rac · Sens: 40 mg/dL"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeletePerfil"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/color_error"
            android:contentDescription="Eliminar perfil" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
