<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <com.example.tfg_diabetesapp.widgets.MedicalHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Escáner IA"
        app:headerSubtitle="Analiza tu comida y calcula los hidratos" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/header_content_overlap_negative"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/content_gap_after_header"
            android:paddingBottom="@dimen/space_3xl">

            <!-- CARD 1: Contexto actual -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado actual"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Glucosa"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/tvContextGlucosa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- mg/dL"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IOB"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/tvContextIob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- U"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COB"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/tvContextCob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- g"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: Imagen del plato -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/layoutPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@color/color_primary_light"
                        android:padding="@dimen/space_2xl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍽️"
                            android:textSize="58sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu plato aparecerá aquí"
                            android:textAppearance="@style/TextAppearance.App.SectionTitle"
                            android:textColor="@color/color_primary"
                            android:layout_marginTop="@dimen/space_md" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pulsa Capturar para escanear\ntu comida con la cámara"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:gravity="center"
                            android:layout_marginTop="@dimen/space_sm" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivFoodPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto del plato"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de cámara -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_lg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="Capturar foto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyze"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="Analizar IA"
                    android:enabled="false"
                    app:backgroundTint="@color/color_secondary" />
            </LinearLayout>

            <!-- Loading -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:background="@color/color_primary_light"
                android:padding="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg">

                <ProgressBar
                    android:id="@+id/progressBarAI"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:indeterminateTint="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analizando tu plato con IA..."
                    android:textColor="@color/color_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="@dimen/space_md" />
            </LinearLayout>

            <!-- CARD 3: Resultado nutricional -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_lg">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tvNombreComida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Plato"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvConfianza"
                        app:layout_constraintHorizontal_bias="0" />

                    <TextView
                        android:id="@+id/tvConfianza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Media"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_primary"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="2dp"
                        android:background="#FF9800"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvDescripcionComida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:layout_marginTop="@dimen/space_xs"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvNombreComida"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/dividerResultado"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider"
                        android:layout_marginTop="@dimen/space_md"
                        app:layout_constraintTop_toBottomOf="@id/tvDescripcionComida" />

                    <!-- Fila 1 del grid -->
                    <LinearLayout
                        android:id="@+id/gridMetricasRow1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="@dimen/space_md"
                        app:layout_constraintTop_toBottomOf="@id/dividerResultado"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvCarbohidratos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 g"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbohidratos"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvFibra"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 g"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fibra"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvProteinas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 g"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Proteínas"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 2 del grid -->
                    <LinearLayout
                        android:id="@+id/gridMetricasRow2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        app:layout_constraintTop_toBottomOf="@id/gridMetricasRow1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvGrasas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 g"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grasas"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvRaciones"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 rac"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Raciones"
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:id="@+id/tvIndiceGlucemico"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Índice Gluc."
                                android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de acción -->
            <LinearLayout
                android:id="@+id/layoutBotonesAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="Guardar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalcularBolo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="Calcular bolo →"
                    app:backgroundTint="@color/color_secondary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
