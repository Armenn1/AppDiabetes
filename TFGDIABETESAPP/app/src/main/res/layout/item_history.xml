<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/color_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 Ene, 14:30"
            android:textSize="12sp"
            android:textColor="@color/color_text_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Badge de tipo (Insulina / Comida) -->
        <TextView
            android:id="@+id/tvTipoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insulina"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_rounded"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Valor principal izquierda (glucosa o raciones) -->
        <TextView
            android:id="@+id/tvGlucosaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="115"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFecha" />

        <!-- Unidad izquierda (mg/dL o rac) -->
        <TextView
            android:id="@+id/tvUnidadIzq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" mg/dL"
            android:textSize="12sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tvGlucosaItem"
            app:layout_constraintBaseline_toBaselineOf="@id/tvGlucosaItem" />

        <!-- Dosis derecha -->
        <TextView
            android:id="@+id/tvDosisItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.0 U"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvGlucosaItem"
            app:layout_constraintBottom_toBottomOf="@id/tvGlucosaItem" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvGlucosaItem" />

        <!-- Detalle (breakdown o nota) -->
        <TextView
            android:id="@+id/tvRacionesItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4 Raciones"
            android:textSize="12sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
