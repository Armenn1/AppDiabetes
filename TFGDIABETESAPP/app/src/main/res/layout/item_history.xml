<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginVertical="@dimen/space_xs"
    app:cardCornerRadius="14dp"
    app:cardElevation="@dimen/card_elevation_sm"
    app:cardBackgroundColor="@color/color_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 Ene, 14:30"
            android:textSize="12sp"
            android:textColor="@color/color_text_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTipoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insulina"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_rounded"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGlucosaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="115"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:layout_marginTop="@dimen/space_xs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFecha" />

        <TextView
            android:id="@+id/tvUnidadIzq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" mg/dL"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:layout_marginStart="@dimen/space_xs"
            app:layout_constraintStart_toEndOf="@id/tvGlucosaItem"
            app:layout_constraintBaseline_toBaselineOf="@id/tvGlucosaItem" />

        <TextView
            android:id="@+id/tvTendenciaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvGlucosaItem"
            app:layout_constraintBaseline_toBaselineOf="@id/tvGlucosaItem" />

        <TextView
            android:id="@+id/tvTipoComidaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvFecha"
            app:layout_constraintBaseline_toBaselineOf="@id/tvFecha" />

        <ImageView
            android:id="@+id/ivFotoComida"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@color/color_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvGlucosaItem"
            app:layout_constraintBottom_toBottomOf="@id/tvRacionesItem" />

        <TextView
            android:id="@+id/tvDosisItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.0 U"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvGlucosaItem"
            app:layout_constraintBottom_toBottomOf="@id/tvGlucosaItem" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="@dimen/space_sm"
            app:layout_constraintTop_toBottomOf="@id/tvGlucosaItem" />

        <TextView
            android:id="@+id/tvRacionesItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4 Raciones"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:layout_marginTop="@dimen/space_sm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
