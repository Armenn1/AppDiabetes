<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <com.example.tfg_diabetesapp.widgets.MedicalHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Aprende"
        app:headerSubtitle="Guía rápida sobre diabetes tipo 1" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/header_content_overlap_negative"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/content_gap_after_header"
            android:paddingBottom="@dimen/space_3xl">

            <!-- Raciones -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/color_primary_light"
                        android:padding="@dimen/space_lg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍞"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Qué es una Ración?"
                            android:textAppearance="@style/TextAppearance.App.SectionTitle"
                            android:textColor="@color/color_primary"
                            android:textSize="16sp"
                            android:layout_marginStart="@dimen/space_md" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Una ración equivale a 10 g de hidratos de carbono (HC). Es la unidad básica para calcular el bolo de insulina antes de comer."
                            android:textSize="15sp"
                            android:textColor="@color/color_text_primary"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ejemplos:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_primary"
                            android:layout_marginTop="@dimen/space_md" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 1 rebanada de pan → ~1,5 raciones\n• 1 fruta mediana → ~1,5-2 raciones\n• 100 g de pasta cocida → ~2 raciones\n• 200 ml de zumo → ~2 raciones"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="@dimen/space_xs" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Regla de los 15 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/color_error_container"
                        android:padding="@dimen/space_lg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La Regla de los 15"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_error_container"
                            android:layout_marginStart="@dimen/space_md" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ante una hipoglucemia (glucosa &lt; 70 mg/dL), actúa así:"
                            android:textSize="15sp"
                            android:textColor="@color/color_text_primary"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Toma 15 g de HC de acción rápida\n   (3 sobres de azúcar, 150 ml de zumo)\n\n2. Espera 15 minutos\n\n3. Vuelve a medir la glucosa\n\n4. Si sigue baja, repite el paso 1"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="@dimen/space_md" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rangos de glucosa -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/color_success_container"
                        android:padding="@dimen/space_lg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rangos de Glucosa"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_success_container"
                            android:layout_marginStart="@dimen/space_md" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/space_md">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_error" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  Hipoglucemia"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="&lt; 70 mg/dL"
                                android:textSize="14sp"
                                android:textColor="@color/color_error"
                                android:gravity="end"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/space_md">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_success" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  En rango"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="70 – 180 mg/dL"
                                android:textSize="14sp"
                                android:textColor="@color/color_success"
                                android:gravity="end"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  Hiperglucemia"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="&gt; 180 mg/dL"
                                android:textSize="14sp"
                                android:textColor="@color/color_warning"
                                android:gravity="end"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- IOB -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/color_primary_light"
                        android:padding="@dimen/space_lg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💉"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IOB: Insulina Activa"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_primary"
                            android:layout_marginStart="@dimen/space_md" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="El IOB (Insulin On Board) es la cantidad de insulina rápida que todavía está actuando en tu cuerpo."
                            android:textSize="15sp"
                            android:textColor="@color/color_text_primary"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="La insulina rápida actúa durante ~4 horas. Tenerla en cuenta al calcular un nuevo bolo evita apilar insulina y sufrir hipoglucemias."
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="@dimen/space_md" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewNews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

</LinearLayout>
